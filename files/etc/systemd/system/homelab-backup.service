[Unit]
Description=Back up to Backblaze B2 with restic
Documentation=file:///etc/homelab/repo/docs/backup-inventory.md
OnFailure=ntfy-alert@%n.service

# The pool holds the photos. The script refuses without it, but declaring it
# here means systemd does not even start the job on a degraded boot.
RequiresMountsFor=/mnt/pool /opt/appdata

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-backup

# THE FIRST RUN IS THE BIG ONE: it uploads the entire photo library, and on a
# domestic upstream that is measured in nights, not hours. restic re-uses what
# is already in the repository, so a run killed by this timeout is not wasted —
# the next one continues from where the data ends.
#
# 12h bounds a genuinely wedged job without failing an honest large upload.
# systemd will not start a second instance while one is running, so a long job
# simply skips the next night rather than overlapping.
TimeoutStartSec=12h

# Backups are background work: never at the expense of the services people are
# actually using. IOSchedulingClass=idle matters most — restic reading the
# whole photo library will otherwise make everything else feel slow.
Nice=19
IOSchedulingClass=idle
CPUWeight=20
