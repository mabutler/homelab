#!/usr/bin/env bash
# /etc/homelab/backup.d/10-vaultwarden.sh - Vaultwarden backup integration hook
# Managed by Ansible - homelab2
# Contract: APP-BACKUP-V1
set -euo pipefail

# shellcheck disable=SC2034
APP_NAME="vaultwarden"
SERVICE_DIR="/opt/services/vaultwarden"
DATA_DIR="$SERVICE_DIR/data"
BACKUP_DIR="$SERVICE_DIR/backups"
SNAPSHOT_PATH="$BACKUP_DIR/snapshot.sqlite3"

ACTION="${1:-pre-backup}"

case "$ACTION" in
    pre-backup)
        mkdir -p "$BACKUP_DIR"
        chmod 0750 "$BACKUP_DIR"

        if [ ! -f "$DATA_DIR/db.sqlite3" ]; then
            echo "WARN: $APP_NAME database not found at $DATA_DIR/db.sqlite3. Skipping dump." >&2
            exit 0
        fi

        rm -f "$SNAPSHOT_PATH"
        if ! sqlite3 "$DATA_DIR/db.sqlite3" "VACUUM INTO '$SNAPSHOT_PATH'"; then
            echo "ERROR: sqlite3 VACUUM INTO failed for $APP_NAME" >&2
            exit 1
        fi

        INTEGRITY=$(sqlite3 "$SNAPSHOT_PATH" "PRAGMA integrity_check;")
        if [ "$INTEGRITY" != "ok" ]; then
            echo "ERROR: $APP_NAME snapshot integrity check failed: $INTEGRITY" >&2
            rm -f "$SNAPSHOT_PATH"
            exit 1
        fi

        chmod 0640 "$SNAPSHOT_PATH"
        echo "$APP_NAME transactional pre-backup snapshot verified ok."
        ;;

    post-restore)
        if [ -f "$SNAPSHOT_PATH" ] && [ ! -f "$DATA_DIR/db.sqlite3" ]; then
            mkdir -p "$DATA_DIR"
            cp "$SNAPSHOT_PATH" "$DATA_DIR/db.sqlite3"
            echo "Restored $APP_NAME db.sqlite3 from snapshot."
        fi

        if [ -d "$DATA_DIR" ]; then
            chown -R 1000:1000 "$DATA_DIR"
            chmod 0700 "$DATA_DIR"
            find "$DATA_DIR" -type f -exec chmod 0600 {} +
            echo "$APP_NAME permissions set to 1000:1000 (0700/0600)."
        fi
        ;;

    *)
        echo "Usage: $0 {pre-backup|post-restore}" >&2
        exit 1
        ;;
esac
