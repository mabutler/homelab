# {{ ansible_managed }}
DOMAIN={{ vaultwarden_domain }}
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | lower }}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | lower }}
{% if vaultwarden_admin_token_hash is defined and vaultwarden_admin_token_hash %}
ADMIN_TOKEN={{ vaultwarden_admin_token_hash }}
{% endif %}
WEBSOCKET_ENABLED={{ vaultwarden_websocket_enabled | lower }}
ENABLE_DB_WAL={{ vaultwarden_enable_db_wal | lower }}
DATABASE_URL=/data/db.sqlite3
ROCKET_PORT={{ vaultwarden_rocket_port | default(80) }}
LOG_LEVEL={{ vaultwarden_log_level | default('info') }}
