# Environment configuration template for Immich
# Copy to .env and adjust sensitive credentials

# Database Configuration
DB_HOSTNAME=database
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=CHANGE_ME_IN_VAULT

# Redis Configuration
REDIS_HOSTNAME=redis
REDIS_PORT=6379

# Storage Configuration
UPLOAD_LOCATION=/mnt/storage/media/photos
DATA_LOCATION=/opt/services/immich/data
BACKUP_LOCATION=/opt/services/immich/backups

# Application Environment
NODE_ENV=production
IMMICH_VERSION=v3.3.6
DB_VERSION=pg16-v0.2.1
REDIS_VERSION=6.2-alpine
PUID=1000
PGID=1001
