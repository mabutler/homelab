# Environment configuration for Immich
# Managed by Ansible - homelab2
# Contract: IMMICH-SERVICE-V1

# Database Configuration
DB_HOSTNAME=database
DB_USERNAME={{ immich_db_user | default('immich') }}
DB_DATABASE_NAME={{ immich_db_name | default('immich') }}
DB_PASSWORD={{ immich_db_pass }}

# Redis Configuration
REDIS_HOSTNAME=redis
REDIS_PORT=6379

# Storage Configuration
UPLOAD_LOCATION={{ immich_storage_dir | default('/mnt/storage/media/photos') }}
DATA_LOCATION={{ immich_data_dir | default('/opt/services/immich/data') }}
BACKUP_LOCATION={{ immich_backup_dir | default('/opt/services/immich/backups') }}

# Application Environment
NODE_ENV=production
IMMICH_VERSION={{ immich_version | default('v3.3.6') }}
DB_VERSION=16-vectorchord0.4.3-pgvectors0.2.0
REDIS_VERSION=6.2-alpine
PUID={{ immich_puid | default(1000) }}
PGID={{ immich_pgid | default(1001) }}
