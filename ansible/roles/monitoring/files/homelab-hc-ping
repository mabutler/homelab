#!/usr/bin/env bash
# /usr/local/bin/homelab-hc-ping
# Heartbeat signal helper for Healthchecks.io dead-man's-switch monitoring
# Conforms to MON-HC-V1 contract

set -euo pipefail

ENV_FILE="/etc/homelab/monitoring.env"
if [[ -f "$ENV_FILE" && -r "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
fi

HEALTHCHECKS_API_URL="${HEALTHCHECKS_API_URL:-https://healthchecks.io/api/v3}"
HEALTHCHECKS_PING_BASE_URL="${HEALTHCHECKS_PING_BASE_URL:-https://hc-ping.com}"
HEALTHCHECKS_API_KEY="${HEALTHCHECKS_API_KEY:-}"
HEALTHCHECKS_PING_KEY="${HEALTHCHECKS_PING_KEY:-}"
CHECKS_FILE="${MONITORING_CHECKS_FILE:-/var/lib/homelab/monitoring/checks.json}"

SLUG=""
EVENT=""
EXIT_CODE=""
UNIT=""
MESSAGE=""

usage() {
    cat <<EOF
Usage: $0 --slug <slug> --event <start|success|fail|stop> [options]

Options:
  --slug <slug>            Check slug identifier (required)
  --event <event>          Event: start, success, fail, stop (required)
  --exit-code <code>       Exit code for fail event (default: fail)
  --unit <unit>            Systemd unit name for log collection
  --message <msg>          Diagnostic message to post with ping
  -h, --help               Show this help message
EOF
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --slug)
            SLUG="$2"
            shift 2
            ;;
        --event)
            EVENT="$2"
            shift 2
            ;;
        --exit-code)
            EXIT_CODE="$2"
            shift 2
            ;;
        --unit)
            UNIT="$2"
            shift 2
            ;;
        --message)
            MESSAGE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

if [[ -z "$SLUG" || -z "$EVENT" ]]; then
    echo "ERROR: --slug and --event are required." >&2
    usage
fi

resolve_ping_url() {
    local s="$1"
    local url=""

    if [[ -f "$CHECKS_FILE" ]]; then
        url=$(jq -r --arg sl "$s" '.checks[$sl].ping_url // ""' "$CHECKS_FILE" 2>/dev/null || echo "")
    fi

    if [[ -n "$url" && "$url" != "null" ]]; then
        echo "$url"
        return 0
    fi

    # Fallback to ping key if available
    if [[ -n "$HEALTHCHECKS_PING_KEY" ]]; then
        echo "${HEALTHCHECKS_PING_BASE_URL%/}/${HEALTHCHECKS_PING_KEY}/${s}"
        return 0
    fi

    # Auto-provision on-demand via homelab-hc-reconcile
    if [[ -x /usr/local/bin/homelab-hc-reconcile && -n "$HEALTHCHECKS_API_KEY" ]]; then
        /usr/local/bin/homelab-hc-reconcile --ensure-slug "$s" >/dev/null 2>&1 || true
        if [[ -f "$CHECKS_FILE" ]]; then
            url=$(jq -r --arg sl "$s" '.checks[$sl].ping_url // ""' "$CHECKS_FILE" 2>/dev/null || echo "")
            if [[ -n "$url" && "$url" != "null" ]]; then
                echo "$url"
                return 0
            fi
        fi
    fi

    # Final fallback directly to slug on base URL
    echo "${HEALTHCHECKS_PING_BASE_URL%/}/${s}"
}

PING_URL=$(resolve_ping_url "$SLUG")

send_ping() {
    local target="$1"
    local data="${2:-}"

    local curl_cmd=(
        curl
        "-fsS"
        "--retry" "3"
        "--retry-delay" "2"
        "--retry-all-errors"
        "--connect-timeout" "5"
        "--max-time" "15"
    )

    if [[ -n "$data" ]]; then
        curl_cmd+=("--data-raw" "$data")
    fi

    "${curl_cmd[@]}" "$target" >/dev/null 2>&1 || {
        echo "Notice: Ping signal to $target failed or timed out" >&2
        return 1
    }
    return 0
}

case "$EVENT" in
    start)
        send_ping "${PING_URL%/}/start" "$MESSAGE"
        ;;
    success)
        send_ping "${PING_URL%/}" "$MESSAGE"
        ;;
    fail)
        FAIL_PATH="${PING_URL%/}/${EXIT_CODE:-fail}"
        send_ping "$FAIL_PATH" "$MESSAGE"
        ;;
    stop)
        # Inspect systemd variables passed to ExecStopPost
        # SERVICE_RESULT: success, exit-code, signal, core-dump, watchdog, etc.
        # EXIT_STATUS: exit code or signal number
        SVC_RES="${SERVICE_RESULT:-success}"
        SVC_EXIT="${EXIT_STATUS:-0}"

        if [[ "$SVC_RES" == "success" && "$SVC_EXIT" == "0" ]]; then
            # Clean exit
            send_ping "${PING_URL%/}" ""
            if [[ -x /usr/local/bin/homelab-ntfy ]]; then
                /usr/local/bin/homelab-ntfy \
                    --component "job-${SLUG}" \
                    --status ok \
                    --title "Job ${UNIT:-$SLUG} succeeded" \
                    --message "Service ${UNIT:-$SLUG} finished successfully." || true
            fi
        else
            # Failure detected
            FAIL_LOGS=""
            if [[ -n "$UNIT" ]]; then
                FAIL_LOGS=$(journalctl -u "$UNIT" -n 25 --no-pager 2>/dev/null || true)
            fi
            FAIL_MSG="Service ${UNIT:-$SLUG} failed with result=${SVC_RES}, status=${SVC_EXIT}."
            if [[ -n "$FAIL_LOGS" ]]; then
                FAIL_MSG="${FAIL_MSG}"$'\n\n'"Recent logs:"$'\n'"${FAIL_LOGS}"
            fi

            send_ping "${PING_URL%/}/${SVC_EXIT}" "$FAIL_MSG" || true

            if [[ -x /usr/local/bin/homelab-ntfy ]]; then
                /usr/local/bin/homelab-ntfy \
                    --component "job-${SLUG}" \
                    --status failing \
                    --priority high \
                    --tags "rotating_light,timer" \
                    --title "[JOB FAILURE] fidelacchius: ${UNIT:-$SLUG}" \
                    --message "$FAIL_MSG" || true
            fi
        fi
        ;;
    *)
        echo "ERROR: Unknown event '$EVENT'. Must be start, success, fail, or stop." >&2
        exit 1
        ;;
esac

exit 0
