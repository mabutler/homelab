# Platform Monitoring & Alerting Runtime Configuration Template
# Deployed to /etc/homelab/monitoring.env (mode 0600 root:root)
# Real secrets must be configured in ansible/inventory/group_vars/all/vault.yml

# ntfy.sh push notification endpoint and secret topic identifier
NTFY_SERVER_URL="https://ntfy.sh"
NTFY_TOPIC="fidelacchius-alerts-CHANGE_ME"
NTFY_TOKEN=""

# healthchecks.io API v3 endpoint and project credentials
HEALTHCHECKS_API_URL="https://healthchecks.io/api/v3"
HEALTHCHECKS_PING_BASE_URL="https://hc-ping.com"
HEALTHCHECKS_API_KEY="hc_rw_CHANGE_ME_PROJECT_API_KEY"
HEALTHCHECKS_PING_KEY=""

# Alert suppression and filesystem threshold parameters
MONITORING_COOLDOWN_SEC=900
MONITORING_DISK_WARN_PCT=85
MONITORING_DISK_CRIT_PCT=95
MONITORING_STATE_DIR="/var/lib/homelab/monitoring/state"
MONITORING_CHECKS_FILE="/var/lib/homelab/monitoring/checks.json"
MONITORING_CATALOG_FILE="/etc/homelab/monitoring/checks-catalog.json"
