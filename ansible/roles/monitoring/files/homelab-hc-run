#!/usr/bin/env bash
# /usr/local/bin/homelab-hc-run
# Generic CLI wrapper for scheduled jobs and ad-hoc commands with Healthchecks.io dead-man's-switch
# Conforms to MON-HC-V1 contract

set -euo pipefail

SLUG=""
NAME=""
SCHEDULE=""
TIMEOUT=""
GRACE=""
COMMAND=()

usage() {
    cat <<EOF
Usage: $0 --slug <slug> [options] -- <command> [args...]

Options:
  --slug <slug>          Check slug identifier (required)
  --name <name>          Human-readable check name
  --schedule <cron>      Cron expression (mutually exclusive with --timeout)
  --timeout <sec>        Timeout in seconds
  --grace <sec>          Grace period in seconds
  -h, --help             Show this help message
EOF
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --slug)
            SLUG="$2"
            shift 2
            ;;
        --name)
            NAME="$2"
            shift 2
            ;;
        --schedule)
            SCHEDULE="$2"
            shift 2
            ;;
        --timeout)
            TIMEOUT="$2"
            shift 2
            ;;
        --grace)
            GRACE="$2"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

if [[ -z "$SLUG" || ${#COMMAND[@]} -eq 0 ]]; then
    echo "ERROR: --slug and a command after -- are required." >&2
    usage
fi

# Signal start of job execution
if [[ -x /usr/local/bin/homelab-hc-ping ]]; then
    /usr/local/bin/homelab-hc-ping --slug "$SLUG" --event start || true
fi

# Execute command, capturing stdout & stderr while preserving live output
OUTPUT_FILE=$(mktemp "/tmp/homelab-hc-run-${SLUG}.XXXXXX")
trap 'rm -f "$OUTPUT_FILE"' EXIT

set +e
"${COMMAND[@]}" 2>&1 | tee "$OUTPUT_FILE"
RC=${PIPESTATUS[0]}
set -e

OUTPUT_TAIL=$(tail -n 50 "$OUTPUT_FILE" 2>/dev/null || echo "")

if [[ $RC -eq 0 ]]; then
    if [[ -x /usr/local/bin/homelab-hc-ping ]]; then
        /usr/local/bin/homelab-hc-ping --slug "$SLUG" --event success || true
    fi
    if [[ -x /usr/local/bin/homelab-ntfy ]]; then
        /usr/local/bin/homelab-ntfy \
            --component "job-${SLUG}" \
            --status ok \
            --title "Job ${SLUG} completed successfully" \
            --message "Command '${COMMAND[*]}' finished with exit code 0." || true
    fi
    exit 0
else
    FAIL_MSG="Command '${COMMAND[*]}' failed with exit code ${RC}."
    if [[ -n "$OUTPUT_TAIL" ]]; then
        FAIL_MSG="${FAIL_MSG}"$'\n\n'"Last 50 log lines:"$'\n'"${OUTPUT_TAIL}"
    fi

    if [[ -x /usr/local/bin/homelab-hc-ping ]]; then
        /usr/local/bin/homelab-hc-ping --slug "$SLUG" --event fail --exit-code "$RC" --message "$FAIL_MSG" || true
    fi
    if [[ -x /usr/local/bin/homelab-ntfy ]]; then
        /usr/local/bin/homelab-ntfy \
            --component "job-${SLUG}" \
            --status failing \
            --priority high \
            --tags "rotating_light,command" \
            --title "[COMMAND FAILURE] fidelacchius: ${SLUG}" \
            --message "$FAIL_MSG" || true
    fi
    exit "$RC"
fi
