# Platform Monitoring & Alerting Runtime Configuration
# Managed by Ansible (role: monitoring) - DO NOT EDIT MANUALLY
# File permissions MUST remain 0600 root:root

# ntfy.sh push notification endpoint and secret topic identifier
NTFY_SERVER_URL="{{ monitoring_ntfy_server_url }}"
NTFY_TOPIC="{{ monitoring_ntfy_topic }}"
NTFY_TOKEN="{{ monitoring_ntfy_token }}"

# healthchecks.io API v3 endpoint and project credentials
HEALTHCHECKS_API_URL="{{ monitoring_healthchecks_api_url }}"
HEALTHCHECKS_PING_BASE_URL="{{ monitoring_healthchecks_ping_url }}"
HEALTHCHECKS_API_KEY="{{ monitoring_healthchecks_api_key }}"
HEALTHCHECKS_PING_KEY="{{ monitoring_healthchecks_ping_key }}"

# Alert suppression and filesystem threshold parameters
MONITORING_COOLDOWN_SEC={{ monitoring_cooldown_sec }}
MONITORING_DISK_WARN_PCT={{ monitoring_disk_warn_pct }}
MONITORING_DISK_CRIT_PCT={{ monitoring_disk_crit_pct }}
MONITORING_STATE_DIR="{{ monitoring_state_dir }}"
MONITORING_CHECKS_FILE="{{ monitoring_checks_file }}"
MONITORING_CATALOG_FILE="{{ monitoring_catalog_file }}"
