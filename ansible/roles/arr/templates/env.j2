# /opt/services/arr/.env
# Managed by Ansible - homelab2
# Mode: 0600 (root:root)

# VPN Mode Selection ("tailscale" default for Tailscale Mullvad / Exit Node; "gluetun" for standalone WireGuard)
ARR_VPN_MODE={{ arr_vpn_mode | default('tailscale') }}

# Container Image Versions
TAILSCALE_VERSION={{ arr_tailscale_version | default('v1.76.6') }}
GLUETUN_VERSION={{ arr_gluetun_version | default('v3.39.1') }}
QBITTORRENT_VERSION={{ arr_qbittorrent_version | default('5.0.2') }}
JELLYFIN_VERSION={{ arr_jellyfin_version | default('10.10.3') }}

# Unified Non-Root Process Ownership & Permissions
PUID={{ arr_puid | default(1000) }}
PGID={{ arr_pgid | default(1001) }}
UMASK={{ arr_umask | default('002') }}
TZ={{ arr_tz | default('America/New_York') }}

# Loopback Port Bindings
ARR_HOST_BIND={{ arr_host_bind | default('127.0.0.1') }}
JELLYFIN_HTTP_PORT={{ arr_jellyfin_port | default(8096) }}
QBITTORRENT_WEBUI_PORT={{ arr_qbittorrent_webui_port | default(8080) }}
GLUETUN_CONTROL_PORT={{ arr_gluetun_control_port | default(8000) }}

# Storage Tier Paths
ARR_SERVICE_DIR={{ arr_service_dir | default('/opt/services/arr') }}
ARR_SCRATCH_INCOMPLETE_DIR={{ arr_scratch_incomplete_dir | default('/mnt/scratch/downloads/incomplete') }}
ARR_STORAGE_ROOT={{ arr_storage_root | default('/mnt/storage') }}
ARR_STORAGE_COMPLETE_DIR={{ arr_storage_complete_dir | default('/mnt/storage/downloads/complete') }}
ARR_STORAGE_MOVIES_DIR={{ arr_storage_movies_dir | default('/mnt/storage/media/movies') }}
ARR_STORAGE_TV_DIR={{ arr_storage_tv_dir | default('/mnt/storage/media/tv') }}

# Hardware Acceleration (Intel Alder Lake-S UHD Graphics 770)
LIBVA_DRIVER_NAME={{ arr_libva_driver_name | default('iHD') }}

# Tailscale Mullvad / Exit Node VPN Configuration
TS_HOSTNAME={{ arr_ts_hostname | default('fidelacchius-arr-vpn') }}
TS_AUTHKEY={{ arr_ts_auth_key }}
TS_EXIT_NODE={{ arr_ts_exit_node | default('auto') }}
TS_STATE_DIR={{ arr_ts_state_dir | default('/var/lib/tailscale') }}
TS_USERSPACE={{ arr_ts_userspace | default('false') }}
TS_ACCEPT_DNS={{ arr_ts_accept_dns | default('true') }}
TS_EXTRA_ARGS=--accept-dns=true

# Optional Standalone Gluetun VPN Configuration (Used only when ARR_VPN_MODE=gluetun)
VPN_SERVICE_PROVIDER={{ arr_vpn_service_provider | default('custom') }}
VPN_TYPE={{ arr_vpn_type | default('wireguard') }}
VPN_ENDPOINT_IP={{ arr_vpn_endpoint_ip | default('') }}
VPN_ENDPOINT_PORT={{ arr_vpn_endpoint_port | default('51820') }}
WIREGUARD_PUBLIC_KEY={{ arr_vpn_wireguard_public_key | default('') }}
WIREGUARD_PRIVATE_KEY={{ arr_vpn_wireguard_private_key | default('') }}
WIREGUARD_ADDRESSES={{ arr_vpn_wireguard_addresses | default('10.2.0.2/32') }}
WIREGUARD_PRESHARED_KEY={{ arr_vpn_wireguard_preshared_key | default('') }}
SERVER_COUNTRIES={{ arr_vpn_server_countries | default('') }}
OPENVPN_USER={{ arr_vpn_openvpn_user | default('') }}
OPENVPN_PASSWORD={{ arr_vpn_openvpn_password | default('') }}
FIREWALL=on
FIREWALL_OUTBOUND_SUBNETS={{ arr_firewall_outbound_subnets | default('192.168.4.0/24') }}
HTTP_CONTROL_SERVER_ADDRESS=:{{ arr_gluetun_control_port | default(8000) }}
