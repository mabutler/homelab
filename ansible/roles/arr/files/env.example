# /opt/services/arr/.env.example
# Managed by Ansible - homelab2
# Copy and populate via Ansible vault.yml (never commit real .env files)

# VPN Mode Selection ("tailscale" default for Tailscale Mullvad / Exit Node; "gluetun" for standalone WireGuard)
ARR_VPN_MODE=tailscale

# Container Image Versions
TAILSCALE_VERSION=v1.76.6
GLUETUN_VERSION=v3.39.1
QBITTORRENT_VERSION=5.0.2
JELLYFIN_VERSION=10.10.3

# Unified Non-Root Process Ownership & Permissions
PUID=1000
PGID=1001
UMASK=002
TZ=America/New_York

# Loopback Port Bindings
ARR_HOST_BIND=127.0.0.1
JELLYFIN_HTTP_PORT=8096
QBITTORRENT_WEBUI_PORT=8080
GLUETUN_CONTROL_PORT=8000

# Storage Tier Paths
ARR_SERVICE_DIR=/opt/services/arr
ARR_SCRATCH_INCOMPLETE_DIR=/mnt/scratch/downloads/incomplete
ARR_STORAGE_ROOT=/mnt/storage
ARR_STORAGE_COMPLETE_DIR=/mnt/storage/downloads/complete
ARR_STORAGE_MOVIES_DIR=/mnt/storage/media/movies
ARR_STORAGE_TV_DIR=/mnt/storage/media/tv

# Hardware Acceleration (Intel Alder Lake-S UHD Graphics 770)
LIBVA_DRIVER_NAME=iHD

# Tailscale Mullvad / Exit Node VPN Configuration (Default: ARR_VPN_MODE=tailscale)
# Set TS_EXIT_NODE=auto to automatically pick the lowest-latency Mullvad exit node via 'tailscale exit-node suggest',
# or specify an explicit exit node hostname/IP (e.g., us-nyc-wg-301.mullvad.ts.net).
TS_HOSTNAME=fidelacchius-arr-vpn
TS_AUTHKEY=tskey-auth-CHANGE_ME
TS_EXIT_NODE=auto
TS_STATE_DIR=/var/lib/tailscale
TS_USERSPACE=false
TS_ACCEPT_DNS=true
TS_EXTRA_ARGS=--accept-dns=true

# Optional Standalone Gluetun VPN Configuration (Used only when ARR_VPN_MODE=gluetun)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
WIREGUARD_PRESHARED_KEY=
SERVER_COUNTRIES=
OPENVPN_USER=
OPENVPN_PASSWORD=
FIREWALL=on
FIREWALL_OUTBOUND_SUBNETS=192.168.4.0/24
HTTP_CONTROL_SERVER_ADDRESS=:8000
