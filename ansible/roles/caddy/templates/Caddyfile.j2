# Global configuration block
{
    default_bind {{ caddy_default_bind | default('127.0.0.1 192.168.4.57') }}
    default_sni {{ caddy_default_sni | default('vaultwarden.lan') }}

    # Log configuration: structured output to stderr/journald
    log {
        output stderr
        format console
        level {{ caddy_log_level | default('INFO') }}
    }

    # Disable admin API port or bind to local unix socket
    admin off
}

# Import all service drop-in configurations
import {{ caddy_conf_dir | default('/etc/caddy/conf.d') }}/*.caddy
