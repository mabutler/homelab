---
# Example secrets template for fidelacchius
# Copy this file to 'vault.yml' in the same directory and fill in your real secrets.
# NEVER commit 'vault.yml' to version control (it is gitignored).

# Administrative Operator
vault_admin_username: "admin"

# Password hash for emergency console login (optional / locked by default)
# Generate with: mkpasswd -m sha-512
vault_admin_password_hash: null

# Authorized SSH public keys for administrative login
vault_admin_authorized_keys:
  - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... operator@workstation"

# Tailscale Auth Key (Phase 3)
# Generate from Tailscale Admin Console -> Settings -> Keys
vault_tailscale_auth_key: "tskey-auth-..."

# Vaultwarden Administrative Token (Phase 5)
# Argon2id hash of the admin portal password
# Generate with: docker run --rm -it vaultwarden/server:1.32.7-alpine /vaultwarden hash
vaultwarden_admin_token_hash: "$argon2id$v=19$m=65536,t=3,p=4$..."

# Backblaze B2 & Restic Backup Secrets (Phase 5 / Offsite Backups)
# From Backblaze B2 Console -> App Keys
vault_b2_account_id: "00xxxxxxxxxxxxxxx"
vault_b2_account_key: "K00xxxxxxxxxxxxxxxxxxxx"
# Restic repository target, e.g. b2:fidelacchius-backups:fidelacchius
vault_restic_repository: "b2:fidelacchius-backups:fidelacchius"
# Strong passphrase used by Restic to encrypt backups client-side
vault_restic_password: "replace-with-a-very-strong-restic-encryption-password"

# Frigate NVR Camera RTSP Credentials & Stream Endpoints (Phase 5)
vault_frigate_camera_1_rtsp_main_url: "rtsp://admin:CHANGE_ME_PASSWORD@192.168.4.201:554/h264Preview_01_main"
vault_frigate_camera_1_rtsp_sub_url: "rtsp://admin:CHANGE_ME_PASSWORD@192.168.4.201:554/h264Preview_01_sub"
vault_frigate_camera_2_rtsp_main_url: "rtsp://admin:CHANGE_ME_PASSWORD@192.168.4.202:554/h264Preview_01_main"
vault_frigate_camera_2_rtsp_sub_url: "rtsp://admin:CHANGE_ME_PASSWORD@192.168.4.202:554/h264Preview_01_sub"

# Immich Photo Management Platform Database Secret (Phase 5)
immich_db_password: "CHANGE_ME_IN_VAULT"

# Platform Monitoring & Alerting (Phase 8)
# ntfy.sh push notification endpoint and secret topic identifier
vault_ntfy_server_url: "https://ntfy.sh"
vault_ntfy_topic: "fidelacchius-alerts-CHANGE_ME"
vault_ntfy_token: ""

# healthchecks.io API v3 project credentials & ping endpoints
vault_healthchecks_api_url: "https://healthchecks.io/api/v3"
vault_healthchecks_ping_url: "https://hc-ping.com"
vault_healthchecks_api_key: "hc_rw_CHANGE_ME_PROJECT_API_KEY"
vault_healthchecks_ping_key: ""

