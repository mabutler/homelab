# host.conf — the only per-machine file in this repository.
#
#   cp host.conf.example host.conf   and fill in the blanks.
#
# host.conf is gitignored. STORE THE REAL FILE IN YOUR PASSWORD MANAGER:
# a rebuild can restore this repository, but not this machine's identity.
#
# Sourced as shell. No spaces around '='; quote anything with spaces.
# A second host is a second host.conf, not a second repository.
#
# Workflow: this repository is cloned to the target, host.conf.example is
# copied to host.conf THERE, and filled in THERE — host.conf is gitignored, so
# it never arrives with the clone. install/03-chroot.sh copies the working tree
# (not a fresh clone) into the target at /opt/stack, which is what carries the
# filled-in host.conf across the reboot.
#
# The identity section is required before anything in install/ will run.
# Everything below it is only needed by the bootstrap step that uses it, so you
# can leave those blank today and fill them in before running run.sh.

# --- identity --------------------------------------------------------------

# The hostname of the machine being built. Named TARGET_HOSTNAME rather than
# HOSTNAME because bash sets HOSTNAME itself, and on the live ISO it is
# "archiso" — a collision that would be silent and confusing.
TARGET_HOSTNAME=""              # e.g. fidelacchius

# Non-root login. Owns the public key in files/authorized_keys, and is added
# to wheel. Root SSH login is disabled, so this account is how you get in.
ADMIN_USER=""                   # e.g. matt

TIMEZONE=""                     # timedatectl list-timezones   e.g. America/New_York
LOCALE="en_US.UTF-8"
KEYMAP="us"

# --- tailnet ---------------------------------------------------------------

# Tags advertised when this node JOINS the tailnet. Optional; leave empty for
# an untagged node owned by your user account.
#
# Set this if anything on the host will ever be published with Tailscale
# Funnel. A tagged node is owned by the tailnet rather than by you, so the
# policy can deny it outbound access to everything — which is what stops a
# compromise of a public-facing container from becoming a foothold on the
# tailnet. Tagged nodes also never expire their keys.
#
# Applied at join time on purpose: advertising a tag re-authenticates the
# machine, which is fine while you are already authenticating and disruptive
# later. Changing this on a host that is already up is a manual step.
#
# The tag must have an owner in the tailnet policy before it can be claimed —
# see apps/vaultwarden/tailnet-policy.hujson.
TAILSCALE_TAGS=""               # e.g. tag:server

# --- backups ---------------------------------------------------------------
#
# restic to Backblaze B2. See docs/backup-inventory.md for WHAT is backed up
# and why each thing is captured the way it is.

# The repository. For B2:  b2:BUCKETNAME:path
# Get this exactly right — a typo does not fail, it creates a SECOND, empty
# repository, and the first you learn of it is a restore that comes back empty.
# bootstrap/80-backup.sh deliberately does not run `restic init` for that reason.
RESTIC_REPOSITORY=""            # e.g. b2:fidelacchius-backup:/

# THE ENCRYPTION KEY FOR EVERY BACKUP YOU HAVE.
#
# Lose it and the repository is unreadable noise. There is no recovery — that
# is the design, not a limitation. Generate it once:
#
#   openssl rand -base64 48
#
# Then store it in Vaultwarden AND somewhere reachable when Vaultwarden is the
# thing that is down. Printed, in a drawer, counts.
RESTIC_PASSWORD=""

# A Backblaze APPLICATION key, scoped to that one bucket — not the master key.
# The master key can delete every bucket on the account, and this one lives on
# a machine that is publicly reachable on port 443.
B2_ACCOUNT_ID=""                # the applicationKeyId
B2_ACCOUNT_KEY=""               # the applicationKey

# Retention. Defaults are sane for a home server; a photo library changes
# slowly and a year of monthlies costs little.
RESTIC_KEEP_DAILY="7"
RESTIC_KEEP_WEEKLY="5"
RESTIC_KEEP_MONTHLY="12"

# --- storage ---------------------------------------------------------------

# Size of the Btrfs root partition. The remainder of the SSD becomes the ext4
# /opt/appdata partition. Accepted by sgdisk, so use GiB/MiB, not GB/MB.
ROOT_SIZE="50GiB"

# --- alerting --------------------------------------------------------------
#
# Not required by install/. bootstrap/60-alerting.sh calls require_conf for
# these and fails naming whichever is blank.

NTFY_SERVER="https://ntfy.sh"

# Long random string. On public ntfy.sh the topic IS the credential: anyone
# who knows it can read your alerts and publish to them. Generate with
#   head -c 24 /dev/urandom | base32 | tr -d '='
NTFY_TOPIC=""

# Healthchecks.io ping URLs — dead-man switches, so a timer that silently
# stops firing is caught by absence rather than by you noticing months later.
# Leave any of these blank to skip wiring that check.
HC_HEARTBEAT_URL=""             # hourly
HC_SNAPRAID_SYNC_URL=""         # nightly
HC_SNAPRAID_SCRUB_URL=""        # weekly
HC_SMART_URL=""                 # weekly SMART attribute snapshot
HC_AUTOUPDATE_URL=""            # daily container auto-update
HC_BACKUP_URL=""                # nightly restic backup
HC_BACKUP_CHECK_URL=""          # weekly restic repository verification

# Any HC_* variable added here is written to /etc/homelab/alerting.env and
# reachable as `hc-ping HC_WHATEVER_URL`. bootstrap/60-alerting.sh does not
# keep its own list.
