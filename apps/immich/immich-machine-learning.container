[Unit]
Description=Immich — machine learning (search and faces)
Documentation=https://docs.immich.app/install/docker-compose

# The model cache is state worth keeping: without it every restart re-downloads
# a few hundred MB of models before anything works.
RequiresMountsFor=/opt/appdata
OnFailure=ntfy-alert@%n.service

[Container]
ContainerName=immich-machine-learning
Image=ghcr.io/immich-app/immich-machine-learning:release
Network=immich.network
AutoUpdate=registry

Volume=/opt/appdata/immich/model-cache:/cache:Z
EnvironmentFile=/etc/homelab/apps/immich.env

[Service]
Restart=always
# Model downloads on first start, over a domestic connection, on this CPU.
TimeoutStartSec=900

# THIS IS THE EXPENSIVE ONE ON THIS HARDWARE.
#
# CLIP embeddings and face detection on a 2011 dual-core Sandy Bridge with no
# AVX2 is slow — expect an initial library scan measured in days, not hours,
# and expect this container to sit at 100% CPU while it runs. It is background
# work and Immich stays usable throughout, but it will make the machine feel
# busy and it will heat the room.
#
# The cap below keeps it from starving Vaultwarden and the pool. Raise it if
# you would rather the scan finished sooner and do not care about latency
# elsewhere; the units are the declaration, so change it here and redeploy.
CPUWeight=20
MemoryHigh=2G
MemoryMax=3G

[Install]
WantedBy=multi-user.target default.target
