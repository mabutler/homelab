# apps/immich/immich.env — copy to immich.env and fill in. GITIGNORED.
#
# One file, read by all four containers, the same way upstream's compose shares
# a single .env. That is why both the DB_* names (what the server connects
# with) and the POSTGRES_* names (what the database initialises itself with)
# are here: they are two views of the same credentials and MUST agree.
#
# PUT A COPY IN YOUR PASSWORD MANAGER. The database is worthless without it.

# --- database ---------------------------------------------------------------

# A-Za-z0-9 only. Immich's own docs are explicit about this: the password ends
# up in a connection URI and punctuation has bitten people.
#   openssl rand -hex 24
DB_PASSWORD=CHANGE-ME

DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# What the database container initialises with on FIRST START ONLY. Changing
# these later does not change the database — it just stops the server being
# able to log in. They must match the three values above.
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_USER=postgres
POSTGRES_DB=immich

# Container names on the immich network. Upstream's compose relies on service
# names; Quadlet has no services, so these are named explicitly.
DB_HOSTNAME=immich-database
REDIS_HOSTNAME=redis

# --- server -----------------------------------------------------------------

# EXIF timestamps are interpreted against this. Match host.conf's TIMEZONE.
TZ=America/New_York
