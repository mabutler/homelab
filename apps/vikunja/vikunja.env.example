# apps/vikunja/vikunja.env — copy to vikunja.env and fill in. GITIGNORED.

# Signs session tokens. CHANGING IT LOGS EVERYONE OUT — and losing it means
# nobody can log in until it is replaced and everyone signs in again.
#   openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=CHANGE-ME

# The browser makes API calls against this, so it must be the address you
# actually type, including the port, with a trailing slash. Get it wrong and
# the page loads but every request fails — a confusing way to be broken.
VIKUNJA_SERVICE_PUBLICURL=https://fidelacchius.EXAMPLE-TAILNET.ts.net:8446/

VIKUNJA_DATABASE_PATH=/db/vikunja.db

# Closed after you and your partner have accounts.
VIKUNJA_SERVICE_ENABLEREGISTRATION=true

VIKUNJA_SERVICE_TIMEZONE=America/New_York
