# apps/mealie/mealie.env — copy to mealie.env and fill in. GITIGNORED.

# The URL the browser will use. Mealie builds links against it, so it has to be
# the real address including the port — not the loopback one.
BASE_URL=https://fidelacchius.EXAMPLE-TAILNET.ts.net:8445

# Closed by default. Open it briefly to add someone, then close it again — the
# same open/register/close cycle as Vaultwarden, and worth the same care even
# though this is tailnet-only.
ALLOW_SIGNUP=false

# The container writes as this user. 1000 matches the first non-root account on
# an Arch install, which keeps /opt/appdata/mealie readable when you go looking.
PUID=1000
PGID=1000

TZ=America/New_York
