# apps/homepage/homepage.env — copy to homepage.env. GITIGNORED.
#
# Homepage REFUSES to serve a request whose Host header is not listed here. It
# is not optional and it is not a warning: get it wrong and you get a bare
# "host not allowed" page rather than the dashboard, which reads like the app
# is broken.
#
# Include the port, because the browser sends it.
HOMEPAGE_ALLOWED_HOSTS=fidelacchius.EXAMPLE-TAILNET.ts.net:8448

# Homepage runs as root by default and this keeps it that way, which is what
# lets it read the config bind-mount without a uid dance.
PUID=0
PGID=0
