# Copy to /etc/homelab/apps/vaultwarden.env, mode 0600, and fill in.
# NOT in git. Store the real file in your existing password manager — the one
# you are migrating away from — because you cannot restore this from the vault
# it configures.

# The canonical URL. Drives WebAuthn's relying-party ID, push registration and
# email links, so changing it later invalidates security keys. This is the
# MagicDNS name, and it stays the same when Funnel is added later — which is
# the whole reason Funnel was chosen over a Cloudflare tunnel.
#   tailscale status --json | jq -r .Self.DNSName   (strip the trailing dot)
DOMAIN=https://fidelacchius.EXAMPLE-TAILNET.ts.net

# TRUE only long enough to create your two accounts, then FALSE and restart.
# Leaving this true on a service that will be publicly reachable means anyone
# who finds the URL can register.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=false

# Rate limiting. Meaningful once Funnel is on; harmless before.
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=5

# Argon2 hash of the admin panel password, NOT the password itself. Generate:
#   podman run --rm -it docker.io/vaultwarden/server:latest /vaultwarden hash
# Comment this out entirely once both accounts exist — Funnel cannot exclude
# /admin by path, so the panel would be publicly reachable.
# ADMIN_TOKEN='$argon2id$v=19$...'

# Bitwarden's free push relay, so vault changes reach phones instantly instead
# of on next sync. Register at https://bitwarden.com/host/ — optional.
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=

# SQLite. Correct for two users; Postgres would be a database to maintain for
# no benefit at this size.
DATABASE_URL=/data/db.sqlite3
ROCKET_PORT=80
